+def mask_dice_weighted_loss(pred_logits, targets, object_valid_mask=None, input_pad_mask=None, sample_weight=None):
+    """DICE loss with a per-element weight, for when not every input is worth the same.
+
+    A separate function rather than a flag on :func:`mask_dice_loss`, which documents that it
+    ignores `sample_weight`. Every caller of the plain version passes one (ObjectHitMaskTask
+    always does, to carry `null_weight`), so honouring it there would silently change the
+    objective of every existing configuration. Opting in by name cannot.
+
+    The weight enters both the intersection and the normalisation, so it is a DICE over a
+    weighted measure of the mask rather than over its cardinality. With a uniform weight this
+    reduces exactly to :func:`mask_dice_loss`, which is asserted in the tests.
+
+    Args:
+        pred_logits: [batch_size, num_objects, num_inputs] - predicted logits for binary masks
+        targets: [batch_size, num_objects, num_inputs] - ground truth binary masks
+        object_valid_mask: [batch_size, num_objects] - mask indicating valid target objects
+        input_pad_mask: [batch_size, num_inputs] - mask indicating valid inputs
+        sample_weight: [batch_size, num_objects, num_inputs] - per-element weight
+
+    Returns:
+        loss: Scalar tensor representing the weighted DICE loss
+    """
+    if object_valid_mask is not None:
+        pred_logits = pred_logits[object_valid_mask]
+        targets = targets[object_valid_mask]
+        sample_weight = sample_weight[object_valid_mask] if sample_weight is not None else None
+
+    probs = pred_logits.sigmoid()
+    if input_pad_mask is not None:
+        probs = probs * input_pad_mask.unsqueeze(1)
+
+    weight = 1.0 if sample_weight is None else sample_weight
+    numerator = 2 * (weight * probs * targets).sum(-1)
+    denominator = (weight * probs).sum(-1) + (weight * targets).sum(-1)
+    loss = 1 - (numerator + 1) / (denominator + 1)
+    return loss.mean()
+
+
