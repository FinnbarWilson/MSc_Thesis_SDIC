__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/

.DS_Store
.venv/
env/

# Everything setup/ builds: the hepattn checkout, the training venv, the conda install (~12 GB).
external/

# Lightning's default_root_dir: one timestamped directory per run, ~114 MB per checkpoint.
logs/

# The raw ColliderML shards are ~300 GB and live outside the repository. Ignored here in case
# someone symlinks the conventional name into the tree.
ColliderML_data

# Optuna study databases, regenerated by scripts.tune_clue.
results/*.db
results/*/*.db

# Per-row score tables: 20-30 MB each at pu0 and several times that at pu200. The committed
# results/<ds>/figure_summary.csv is what travels instead. Regenerate these with
# `python -m scripts.score --algo <name>` on a machine holding the event store.
results/*/particles_*.parquet
results/*/clusters_*.parquet
results/*/soft_particles_*.parquet

# Rebuildable cache from the event store, not a result.
results/*/anatomy_particles.parquet

docs/
