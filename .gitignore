__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

.DS_Store
.venv/
env/
docs/

# --- Build artefacts, all under one directory -------------------------------
# `setup/` builds everything the GPU half needs into external/: the hepattn checkout, the
# training venv, and the conda install that carries the analysis env. None of it is ours and
# none of it is small (~12 GB), so it is rebuilt rather than tracked -- `setup/README.md` is
# the reproducible part. One ignored directory rather than three keeps "what is generated"
# answerable by `ls`.
external/

# The raw ColliderML shards are ~300 GB and live outside the repository entirely
# (/mnt/ai-datastore/finnbar/ColliderML_data). Nothing here should ever point inside the repo
# for them, but ignore the conventional name in case someone symlinks it.
ColliderML_data

# Optuna study databases are regenerated by the tuning script
results/*.db
results/*/*.db

# --- Result tables ----------------------------------------------------------
# What gets committed is what an assessor needs to regenerate the figures without a GPU: the
# small pooled summaries, the working-point scans, the tuned parameters, the logs. What does
# not is the per-row tables, which are 20-30 MB each at pu0 and scale with cells per event --
# pu200 puts ~200 pileup interactions on top of the same hard scatter, so the same five
# algorithms produce several times that again, in a repository whose .git is already 384 MB
# on iCloud Drive.
#
# The pu0 tables committed before this rule stay tracked: git does not un-track a file
# because a pattern appears later, and losing the reference set to a housekeeping change
# would be a bad trade. This governs pu200 and anything scored from here on. To drop the pu0
# ones deliberately:  git rm --cached results/pu0/particles_*.parquet
#
# Regenerate any of them with  python -m scripts.score --algo <name>.
results/*/particles_*.parquet
results/*/clusters_*.parquet
results/*/soft_particles_*.parquet

# Rebuildable caches, not results. make_thesis_figures.py builds these from the event store
# with --rebuild-anatomy / --rebuild-jets; the pass costs minutes, the file costs 44 MB, and a
# tracked copy would be 86% of the repository for something no figure needs to be handed.
# The SCORED tables beside them (particles_*.parquet, clusters_*.parquet) are results and stay.
results/*/anatomy_particles.parquet

# Same status, from make_dataset_figures.py --rebuild: the per-particle features read out of
# the raw ColliderML parquet. Rebuildable only on a machine that HAS the raw shards, which is
# why the small CSV beside it -- dataset_features_selection*.csv, what each cut costs -- is
# tracked instead. That is the number a reader needs; the 100 MB table is not.
results/*/dataset_features*.parquet
