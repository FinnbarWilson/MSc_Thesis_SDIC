__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

.DS_Store
.venv/
env/

# Everything setup/ builds: the hepattn checkout, the training venv, the conda install (~12 GB).
external/

# Lightning's default_root_dir on DIAS -- one timestamped directory per run, ~114 MB per checkpoint.
logs/

# The raw ColliderML shards are ~300 GB and live outside the repository. Ignore the conventional
# name in case someone symlinks it.
ColliderML_data

# Optuna study databases, regenerated by scripts.tune_clue.
results/*.db
results/*/*.db

# --- Result tables ----------------------------------------------------------
# Committed: the small binned summaries, the scans, the tuned parameters -- everything needed to
# redraw the figures without a GPU. Not committed: the per-row tables, 20-30 MB each at pu0 and
# several times that at pu200. No per-row table has ever been in this repository's history
# (`git log --all -- 'results/*/particles_*.parquet'` returns nothing), so a fresh clone has none.
#
# results/<ds>/figure_summary.csv is what travels instead: ~20 KB per dataset, and the reason pu0
# (scored on DIAS) and pu200 (scored on ce-ai-1) can appear in one figure. It is deliberately
# tracked. Regenerate the rest with  python -m scripts.score --algo <name>.
results/*/particles_*.parquet
results/*/clusters_*.parquet
results/*/soft_particles_*.parquet

# Rebuildable caches from the event store, not results.
results/*/anatomy_particles.parquet
results/*/dataset_features*.parquet
